{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "EY.HRPlatform.Identity",
    "Audience": "EY.HRPlatform"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": { "ClusterId": "identity-cluster", "Match": { "Path": "/api/identity/{**catch-all}" } },
      "training-route": { "ClusterId": "training-cluster", "Match": { "Path": "/api/training/{**catch-all}" } },
      "interview-route": { "ClusterId": "interview-cluster", "Match": { "Path": "/api/interview/{**catch-all}" } },
      "ai-route": { "ClusterId": "ai-cluster", "Match": { "Path": "/api/ai/{**catch-all}" } },
      "corehr-health-route": { "ClusterId": "corehr-cluster", "Match": { "Path": "/api/corehr/health/{**remainder}" }, "Transforms": [{ "PathRemovePrefix": "/api/corehr" }] },
      "corehr-swagger-route": { "ClusterId": "corehr-cluster", "Match": { "Path": "/api/corehr/swagger/{**catch-all}" } },
      "corehr-route": { "ClusterId": "corehr-cluster", "AuthorizationPolicy": "default", "Match": { "Path": "/api/corehr/{**catch-all}" } },
      "performance-health-route": { "ClusterId": "performance-cluster", "Match": { "Path": "/api/performance/health/{**remainder}" }, "Transforms": [{ "PathRemovePrefix": "/api/performance" }] },
      "corehr-unsubscribe-route": { "ClusterId": "corehr-cluster", "Match": { "Path": "/api/corehr/notifications/unsubscribe", "Methods": [ "POST" ] } },
      "performance-unsubscribe-route": { "ClusterId": "performance-cluster", "Match": { "Path": "/api/performance/notifications/unsubscribe", "Methods": [ "POST" ] } },
      "performance-calendar-feed-route": { "ClusterId": "performance-cluster", "Match": { "Path": "/api/performance/calendar/{token}", "Methods": [ "GET" ] } },
      "performance-route": { "ClusterId": "performance-cluster", "AuthorizationPolicy": "default", "Match": { "Path": "/api/performance/{**catch-all}" } }
    },
    "Clusters": {
      "identity-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5101/" } } },
      "training-cluster": { "HttpRequest": { "ActivityTimeout": "00:03:00" }, "Destinations": { "destination1": { "Address": "http://localhost:5201/" } } },
      "interview-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5209/" } } },
      "ai-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:8008/" } } },
      "corehr-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5301/" } } },
      "performance-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5401/" } } }
    }
  },
  "AllowedHosts": "*"
}
